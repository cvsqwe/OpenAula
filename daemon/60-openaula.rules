# Aula F75 - access for the logged in user (uaccess), no root needed.
# hidraw for lighting, evdev + uinput for openaula-remapd.

# lighting
SUBSYSTEMS=="usb|hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"

# keyboard input (remapd, reactive effects)
SUBSYSTEM=="input", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"

# uinput for remapd
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
